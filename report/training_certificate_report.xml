<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_training_certificate" model="report.paperformat">
        <field name="name">Certificat Bensizwe (A4 paysage, sans marge)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_training_certificate" model="ir.actions.report">
        <field name="name">Certificat de formation</field>
        <field name="model">website.training.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">website_bensizwe.report_training_certificate</field>
        <field name="report_file">website_bensizwe.report_training_certificate</field>
        <field name="print_report_name">'Certificat - %s - %s' % (object.participant_name, object.code)</field>
        <field name="paperformat_id" ref="paperformat_training_certificate"/>
        <field name="binding_model_id" ref="model_website_training_certificate"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        Maquette « CERTIFICAT BENSIZWE ACADEMY (Update) » : fond sans texte
        (static/src/img/certificat/fond_certificat.jpg, A4 paysage, image du PDF fourni) sur lequel les
        textes sont positionnés en absolu. Unités en mm sur A4 (297 x 210) ; chaque position vient du PDF
        de la maquette (780 x 540 pt) converti : x_mm = x_pt x 0.3808, y_mm = y_pt x 0.3808.
        Textes en Montserrat (la maquette est en Calibri, absente du serveur), tailles réglées pour
        occuper la même largeur.
    -->
    <template id="report_training_certificate">
        <t t-set="full_width" t-value="True"/>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="title" t-value="o.get_training_label()"/>
                <t t-set="sentence" t-value="o.get_sentence()"/>
                <t t-set="name_len" t-value="len(o.participant_name or '')"/>
                <!-- .article : chaque certificat est rendu dans web.minimal_layout (charset, base url) = 1 page -->
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <style>
                        /* Odoo ne charge que Montserrat Regular pour les rapports : on déclare aussi le Bold
                           (sinon le gras dépend du moteur : synthétisé sous Windows, absent dans Docker). */
                        @font-face {
                            font-family: 'BszMontserrat'; font-weight: 400; font-style: normal;
                            src: url('/web/static/fonts/google/Montserrat/Montserrat-Regular.ttf') format('truetype');
                        }
                        @font-face {
                            font-family: 'BszMontserrat'; font-weight: 700; font-style: normal;
                            src: url('/web/static/fonts/google/Montserrat/Montserrat-Bold.ttf') format('truetype');
                        }
                        html, body, body.container, body.container-fluid, #wrapwrap, main {
                            margin: 0 !important;
                            padding: 0 !important;
                            max-width: none !important;
                            width: 297mm !important;
                            background: #fff;
                        }
                        .bsz-cert {
                            position: relative;
                            width: 297mm;
                            height: 209.5mm;
                            overflow: hidden;
                            font-family: 'BszMontserrat', 'Montserrat', 'Helvetica Neue', Helvetica, Arial, sans-serif;
                            color: #000;
                        }
                        .bsz-cert-bg {
                            position: absolute;
                            top: 0; left: 0;
                            width: 297mm;
                            height: 210mm;
                        }
                        .bsz-abs { position: absolute; }
                        /* Blocs centrés sur la ligne du nom (centre = 150.5 mm), 1 ou 2 lignes centrées verticalement */
                        .bsz-mid { display: table; width: 200mm; left: 50.5mm; }
                        .bsz-mid > div { display: table-cell; vertical-align: middle; text-align: center; }
                        .bsz-title { top: 78mm; height: 11mm; color: #0070c0; font-weight: bold; line-height: 1.15; }
                        .bsz-name {
                            top: 98.8mm; left: 66.5mm; width: 168mm;
                            height: 8mm; line-height: 8mm;
                            text-align: center;
                            font-weight: bold;
                            text-transform: uppercase;
                            white-space: nowrap;
                        }
                        .bsz-sentence { top: 111.9mm; height: 12mm; line-height: 1.25; }
                        .bsz-info {
                            left: 37.2mm; width: 120mm;
                            height: 4.4mm; line-height: 4.4mm;
                            font-size: 8.6pt;
                            white-space: nowrap;
                        }
                        .bsz-sign {
                            top: 188.3mm; width: 60mm; height: 4mm; line-height: 4mm;
                            text-align: center;
                            font-size: 8pt;
                            font-weight: bold;
                            color: #0b2a5c;
                            white-space: nowrap;
                        }
                        .bsz-signature {
                            display: table;
                            top: 177mm; width: 44mm; height: 9.2mm;
                        }
                        .bsz-signature > div { display: table-cell; vertical-align: bottom; text-align: center; }
                        .bsz-signature img { max-width: 44mm; max-height: 9.2mm; }
                        .bsz-qr { top: 142.9mm; left: 253.8mm; width: 16.5mm; height: 16.5mm; }
                    </style>
                    <div class="bsz-cert">
                        <img class="bsz-cert-bg" src="/website_bensizwe/static/src/img/certificat/fond_certificat.jpg"/>

                        <!-- Intitulé (bleu), sous « CERTIFICAT DE FORMATION » -->
                        <div class="bsz-abs bsz-mid bsz-title">
                            <div t-att-style="'font-size: %spt;' % (17 if len(title) &lt;= 45 else 13 if len(title) &lt;= 70 else 10.5)"
                                 t-esc="title"/>
                        </div>

                        <!-- Nom, posé sur la ligne du fond -->
                        <div class="bsz-abs bsz-name"
                             t-att-style="'font-size: %spt;' % (15 if name_len &lt;= 28 else 13.5 if name_len &lt;= 36 else 11.5 if name_len &lt;= 44 else 9.5)"
                             t-esc="o.participant_name"/>

                        <!-- A suivi avec succès la formation de 14h00 (Théorie + Pratique) -->
                        <div class="bsz-abs bsz-mid bsz-sentence">
                            <div t-att-style="'font-size: %spt;' % (15 if len(sentence) &lt;= 70 else 13 if len(sentence) &lt;= 100 else 11)"
                                 t-esc="sentence"/>
                        </div>

                        <!-- Date, lieu, référence -->
                        <div class="bsz-abs bsz-info" style="top: 146.7mm;">Date de délivrance : <t t-esc="o.issue_date.strftime('%d/%m/%Y')"/></div>
                        <div class="bsz-abs bsz-info" style="top: 151.1mm;">Lieu : BENSIZWE ACADEMY - <t t-esc="o.place or 'Kinshasa'"/></div>
                        <div class="bsz-abs bsz-info" style="top: 155.4mm;">Réf Certificat : <t t-esc="o.code"/></div>

                        <!-- QR code dans le cadre du fond -->
                        <img class="bsz-abs bsz-qr" t-att-src="o.get_qr_code_data_uri()"/>

                        <!-- Formateur / Directeur Général : noms sous les pointillés, signature du DG si renseignée -->
                        <div class="bsz-abs bsz-sign" style="left: 43mm;" t-if="o.trainer_name" t-esc="o.trainer_name"/>
                        <div class="bsz-abs bsz-sign" style="left: 185mm;" t-if="o.director_name" t-esc="o.director_name"/>
                        <div class="bsz-abs bsz-signature" style="left: 49.3mm;" t-if="o.training_id.trainer_signature">
                            <div><img t-att-src="image_data_uri(o.training_id.trainer_signature)"/></div>
                        </div>
                        <div class="bsz-abs bsz-signature" style="left: 194.2mm;" t-if="o.training_id.director_signature">
                            <div><img t-att-src="image_data_uri(o.training_id.director_signature)"/></div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>

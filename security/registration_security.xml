<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Portail : un candidat ne voit que ses propres inscriptions (/my/formations) -->
    <record id="rule_website_training_registration_portal" model="ir.rule">
        <field name="name">Inscriptions : candidat du portail</field>
        <field name="model_id" ref="model_website_training_registration"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
